{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>AndreaCovelli/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)mise\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>[^\\s]+)\\s+RENOVATE_IMAGE=[^\\s]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
