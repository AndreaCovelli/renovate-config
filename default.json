{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:minimumReleaseAgePypi"
  ],
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "description": "Group non-breaking mise tool updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchJsonata": ["isBreaking != true"],
      "groupName": "mise tools"
    },
    {
      "description": "Group non-breaking GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchJsonata": ["isBreaking != true"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group non-breaking Python package updates",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchJsonata": ["isBreaking != true"],
      "groupName": "Python dependencies"
    },
    {
      "description": "Group non-breaking Go module updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchJsonata": ["isBreaking != true"],
      "groupName": "Go modules"
    },
    {
      "description": "Pin digests without waiting for the release-age cooldown",
      "matchUpdateTypes": ["pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Automerge non-breaking updates after CI and a 14-day cooldown",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchJsonata": ["isBreaking != true"],
      "minimumReleaseAge": "7 days",
      "automerge": true
    }
  ]
}
