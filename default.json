{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:minimumReleaseAgePypi"
  ],
  "automergeStrategy": "squash",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "timezone": "Europe/Rome",
  "schedule": ["every 2 weeks on monday"],
  "packageRules": [
    {
      "description": "Group mise tool updates",
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group Python package updates",
      "matchManagers": ["pep621"],
      "groupName": "Python dependencies"
    },
    {
      "description": "Group Go module updates",
      "matchManagers": ["gomod"],
      "groupName": "Go modules"
    },
    {
      "description": "Tidy Go modules after dependency updates",
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "description": "Pin digests without waiting for the release-age cooldown",
      "matchUpdateTypes": ["pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Automerge non-breaking updates after CI and cooldown",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchJsonata": ["isBreaking != true"],
      "minimumReleaseAge": "7 days",
      "automerge": true
    }
  ]
}
